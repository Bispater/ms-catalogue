# ====================================================================================
# ARCHIVO DE CONFIGURACIÓN PARA PRODUCCIÓN
# ====================================================================================
# ⚠️  IMPORTANTE: Este archivo contiene configuraciones sensibles
# ⚠️  NUNCA commitees este archivo a Git
# ⚠️  Reemplaza TODOS los valores de ejemplo con valores reales y seguros
# ====================================================================================

# ====================
# Configuración Django - PRODUCCIÓN
# ====================
DEBUG=True
# ⚠️ CAMBIAR: Genera una clave secreta única y segura (50+ caracteres aleatorios)
# Puedes generarla con: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=Abc123@Favric

# Dominios permitidos para catalogue.favric.cl
ALLOWED_HOSTS=catalogue.favric.cl,.catalogue.favric.cl,favric.cl,.favric.cl

# Configuración de idioma y zona horaria
LANGUAGE_CODE=es-cl
TIME_ZONE=America/Santiago
USE_I18N=True
USE_L10N=True
USE_TZ=True

# ====================
# Base de Datos (PostgreSQL) - PRODUCCIÓN
# ====================
DB_ENGINE=django.db.backends.postgresql
# Base de datos para catalogue.favric.cl
DB_NAME=catalogue_favric_prod
# Usuario de PostgreSQL
DB_USER=catalogue_user
# ⚠️ CAMBIAR: Contraseña segura (mínimo 16 caracteres, con mayúsculas, minúsculas, números y símbolos)
DB_PASSWORD=357357@Favric
# Host de base de datos (servicio Docker)
DB_HOST=db
DB_PORT=5432

# Variables para docker-compose.prod.yml (consistencia)
POSTGRES_DB=catalogue_favric_prod
POSTGRES_USER=catalogue_user
POSTGRES_PASSWORD=357357@Favric

# Configuración adicional de PostgreSQL
# Para conexiones SSL (recomendado en producción)
DB_SSL_MODE=require
DB_CONN_MAX_AGE=600

# ====================
# Redis (Para caché y Celery) - PRODUCCIÓN
# ====================
# ⚠️ CAMBIAR: URL de Redis en producción
REDIS_URL=redis://:REDIS_PASSWORD@redis:6379/0
# ⚠️ CAMBIAR: Contraseña de Redis
REDIS_PASSWORD=357357@Favric

# ====================
# Configuración de Email - PRODUCCIÓN
# ====================
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# ⚠️ CAMBIAR: Configuración de tu servidor SMTP
# Ejemplos comunes:
# - Gmail: smtp.gmail.com (puerto 587)
# - SendGrid: smtp.sendgrid.net (puerto 587)
# - AWS SES: email-smtp.us-east-1.amazonaws.com (puerto 587)
# - Mailgun: smtp.mailgun.org (puerto 587)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
# ⚠️ CAMBIAR: Credenciales de email
EMAIL_HOST_USER=noreply@favric.cl
# ⚠️ CAMBIAR: Contraseña o App Password (para Gmail usa App Password)
EMAIL_HOST_PASSWORD=CAMBIAR-POR-CONTRASEÑA-DE-EMAIL
# Email que aparecerá como remitente
DEFAULT_FROM_EMAIL=noreply@favric.cl
SERVER_EMAIL=errors@favric.cl

# ====================
# Almacenamiento en la Nube (AWS S3) - PRODUCCIÓN
# ====================
# ⚠️ CAMBIAR: Credenciales de AWS
AWS_ACCESS_KEY_ID=CAMBIAR-POR-TU-AWS-ACCESS-KEY-ID
AWS_SECRET_ACCESS_KEY=CAMBIAR-POR-TU-AWS-SECRET-ACCESS-KEY
# ⚠️ CAMBIAR: Nombre de tu bucket S3
AWS_STORAGE_BUCKET_NAME=ms-catalogue-prod
# ⚠️ CAMBIAR: Región de AWS donde está tu bucket
AWS_S3_REGION_NAME=us-east-1
AWS_S3_CUSTOM_DOMAIN=${AWS_STORAGE_BUCKET_NAME}.s3.amazonaws.com
AWS_DEFAULT_ACL=public-read
AWS_QUERYSTRING_AUTH=False
AWS_S3_FILE_OVERWRITE=False
# AWS_S3_OBJECT_PARAMETERS se configura en settings.py, no aquí
# AWS_S3_OBJECT_PARAMETERS={'CacheControl': 'max-age=86400'}

# Habilitar S3 para archivos estáticos y media
USE_S3=True
STATICFILES_STORAGE=storages.backends.s3boto3.S3Boto3Storage
DEFAULT_FILE_STORAGE=storages.backends.s3boto3.S3Boto3Storage

# URLs alternativas si NO usas S3 (comentar si usas S3)
# MEDIA_URL=/media/
# STATIC_URL=/static/

# ====================
# Seguridad - PRODUCCIÓN (CRÍTICO)
# ====================
# ⚠️ IMPORTANTE: Estas configuraciones son CRÍTICAS para la seguridad

# Forzar HTTPS
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# Protección XSS y clickjacking
SECURE_BROWSER_XSS_FILTER=True
SECURE_CONTENT_TYPE_NOSNIFF=True
X_FRAME_OPTIONS=DENY

# HSTS (HTTP Strict Transport Security)
# Fuerza HTTPS por 1 año
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# Dominios de confianza para CSRF
CSRF_TRUSTED_ORIGINS=https://catalogue.favric.cl,https://www.catalogue.favric.cl,https://favric.cl,https://www.favric.cl

# Cookies
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_HTTPONLY=False
CSRF_COOKIE_SAMESITE=Lax

# ====================
# Configuración de CORS - PRODUCCIÓN
# ====================
# Orígenes permitidos para CORS (incluye localhost para desarrollo de Angular)
CORS_ALLOWED_ORIGINS=https://catalogue.favric.cl,https://favric.cl,http://localhost:4200,http://localhost:4201,http://127.0.0.1:4200,http://127.0.0.1:4201
CORS_ALLOW_CREDENTIALS=True
CORS_ALLOW_HEADERS=accept,accept-encoding,authorization,content-type,dnt,origin,user-agent,x-csrftoken,x-requested-with,cache-control
CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS

# ====================
# Configuración de CKEditor
# ====================
CKEDITOR_UPLOAD_PATH=uploads/
CKEDITOR_IMAGE_BACKEND=pillow
CKEDITOR_JQUERY_URL=https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js
# Nota: CKEDITOR_CONFIGS se configura en settings.py

# ====================
# Configuración de Celery - PRODUCCIÓN
# ====================
CELERY_BROKER_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
CELERY_RESULT_BACKEND=redis://:${REDIS_PASSWORD}@redis:6379/0
CELERY_ACCEPT_CONTENT=json
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_TIMEZONE=America/Santiago
CELERY_TASK_TRACK_STARTED=True
CELERY_TASK_TIME_LIMIT=30*60
CELERY_WORKER_PREFETCH_MULTIPLIER=4
CELERY_WORKER_MAX_TASKS_PER_CHILD=1000

# ====================
# Monitoreo y Logging - PRODUCCIÓN
# ====================
# ⚠️ CAMBIAR: DSN de Sentry para monitoreo de errores
# Obtén tu DSN en: https://sentry.io/
SENTRY_DSN=https://CAMBIAR@o123456.ingest.sentry.io/123456
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# Nivel de logging
LOG_LEVEL=INFO

# ====================
# Analytics y Tracking - PRODUCCIÓN
# ====================
# ⚠️ CAMBIAR: ID de Google Analytics (si lo usas)
GOOGLE_ANALYTICS_ID=UA-XXXXXXXXX-X
# O para GA4:
# GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# ====================
# reCAPTCHA - PRODUCCIÓN (Opcional)
# ====================
# ⚠️ CAMBIAR: Claves de reCAPTCHA v2 o v3
# Obtén tus claves en: https://www.google.com/recaptcha/admin
RECAPTCHA_PUBLIC_KEY=CAMBIAR-POR-TU-RECAPTCHA-PUBLIC-KEY
RECAPTCHA_PRIVATE_KEY=CAMBIAR-POR-TU-RECAPTCHA-PRIVATE-KEY

# ====================
# Pagos con Stripe - PRODUCCIÓN (Opcional)
# ====================
# ⚠️ CAMBIAR: Claves de Stripe en modo LIVE (NO test)
# Obtén tus claves en: https://dashboard.stripe.com/apikeys
STRIPE_PUBLIC_KEY=pk_live_CAMBIAR-POR-TU-CLAVE-PUBLICA
STRIPE_SECRET_KEY=sk_live_CAMBIAR-POR-TU-CLAVE-SECRETA
STRIPE_WEBHOOK_SECRET=whsec_CAMBIAR-POR-TU-WEBHOOK-SECRET

# ====================
# Configuración de Backup - PRODUCCIÓN
# ====================
# Configuración para backups automáticos
BACKUP_ENABLED=True
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
# ⚠️ CAMBIAR: Bucket S3 para backups
BACKUP_S3_BUCKET=ms-catalogue-backups

# ====================
# Rate Limiting - PRODUCCIÓN
# ====================
# Límites de peticiones para prevenir abuso
RATELIMIT_ENABLE=True
RATELIMIT_USE_CACHE=default
RATELIMIT_VIEW_RATE=100/h
RATELIMIT_API_RATE=1000/h

# ====================
# Configuración de Workers - PRODUCCIÓN
# ====================
# Número de workers de Gunicorn (recomendado: 2-4 x número de CPUs)
WEB_CONCURRENCY=4
# Timeout de workers (en segundos)
GUNICORN_TIMEOUT=120

# ====================
# Configuración de Base de Datos - Optimización
# ====================
# Pool de conexiones
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# ====================
# Configuración de CDN - PRODUCCIÓN (Opcional)
# ====================
# Si usas CloudFront u otro CDN
# CDN_DOMAIN=d1234567890.cloudfront.net
# STATIC_URL=https://${CDN_DOMAIN}/static/
# MEDIA_URL=https://${CDN_DOMAIN}/media/

# ====================
# Variables de Entorno Adicionales
# ====================
# Identificador del entorno
ENVIRONMENT=production
DJANGO_SETTINGS_MODULE=core.settings

# ====================================================================================
# CHECKLIST ANTES DE DESPLEGAR A PRODUCCIÓN
# ====================================================================================
# [ ] Cambiar SECRET_KEY por una clave única y segura
# [ ] Configurar ALLOWED_HOSTS con tus dominios reales
# [ ] Configurar credenciales de base de datos seguras
# [ ] Configurar Redis con contraseña
# [ ] Configurar servidor de email (SMTP)
# [ ] Configurar AWS S3 para archivos estáticos y media
# [ ] Configurar Sentry para monitoreo de errores
# [ ] Verificar que DEBUG=False
# [ ] Verificar que todas las configuraciones de seguridad estén habilitadas
# [ ] Configurar CORS_ALLOWED_ORIGINS con tus dominios
# [ ] Configurar CSRF_TRUSTED_ORIGINS con tus dominios
# [ ] Configurar certificado SSL/TLS en tu servidor
# [ ] Configurar backups automáticos de base de datos
# [ ] Probar en un entorno de staging antes de producción
# ====================================================================================
